      <Border Background="{DynamicResource Theme_111C2B}" BorderBrush="{DynamicResource Theme_233249}" BorderThickness="1" CornerRadius="17" Padding="17" Margin="0,0,10,0">
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="48" Height="48" CornerRadius="16" Background="{DynamicResource Theme_KpiVioletBg}" VerticalAlignment="Top"><TextBlock Text="▰" Foreground="{DynamicResource Theme_KpiViolet}" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="13,1,0,0"><TextBlock Text="CAMBIOS PENDIENTES" Foreground="{DynamicResource Theme_8295AF}" FontSize="8" FontWeight="Bold" CharacterSpacing="40"/><TextBlock x:Name="PendingChangesCount" Text="0" Foreground="{DynamicResource Theme_F1F6FD}" FontSize="31" FontWeight="Bold" Margin="0,4,0,0"/><TextBlock x:Name="SyncEngineStatusText" Text="Monitor local inactivo" Foreground="{DynamicResource Theme_D9AD61}" FontSize="9" TextWrapping="Wrap"/></StackPanel></Grid>
      </Border>
      <Border Background="{DynamicResource Theme_111C2B}" BorderBrush="{DynamicResource Theme_233249}" BorderThickness="1" CornerRadius="17" Padding="17" Margin="0,0,10,0">
