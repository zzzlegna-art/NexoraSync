 <Grid x:Name="Root">
  <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Grid.Column="0" Background="{DynamicResource Theme_0D1421}" BorderBrush="{DynamicResource Theme_1B293B}" BorderThickness="0,0,1,0">
   <Grid Margin="22,26,20,22">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
     <StackPanel Orientation="Horizontal" Margin="4,2,0,32">
      <Border Width="48" Height="48" CornerRadius="15" Background="{DynamicResource Theme_183B62}" BorderBrush="{DynamicResource Theme_2864A1}" BorderThickness="1"><TextBlock Text="N" Foreground="{DynamicResource Theme_70B8FF}" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
      <StackPanel Margin="11,0,0,0" VerticalAlignment="Center"><TextBlock Text="NEXORA" Foreground="{DynamicResource Theme_F4F8FF}" FontSize="19" FontWeight="Bold"/><TextBlock Text="S Y N C" Foreground="{DynamicResource Theme_60AFFF}" FontSize="9" FontWeight="Bold" Margin="1,1,0,0"/></StackPanel>
     </StackPanel>
     <TextBlock Text="ESPACIO DE TRABAJO" Foreground="{DynamicResource Theme_61738C}" FontSize="9" FontWeight="Bold" Margin="9,0,0,10"/>
     <Button x:Name="NavOverview" Content="◫    Resumen" Style="{StaticResource NavButton}" Background="{DynamicResource Theme_172A40}" Foreground="{DynamicResource Theme_FFFFFF}" Click="NavOverview_Click"/>
     <Button x:Name="NavFolder" Content="▣    Carpeta compartida" Style="{StaticResource NavButton}" Click="NavFolder_Click"/>
     <Button x:Name="NavActivity" Content="◷    Actividad" Style="{StaticResource NavButton}" Click="NavActivity_Click"/>
     <Button x:Name="NavDevices" Content="▤    Dispositivos" Style="{StaticResource NavButton}" Click="NavDevices_Click"/>
     <TextBlock Text="PREFERENCIAS" Foreground="{DynamicResource Theme_61738C}" FontSize="9" FontWeight="Bold" Margin="9,27,0,10"/>
     <Button x:Name="NavSettings" Content="⚙    Configuración" Style="{StaticResource NavButton}" Click="NavSettings_Click"/>
     <Button x:Name="NavGuide" Content="ⓘ    Cómo utilizarlo" Style="{StaticResource NavButton}" Click="NavGuide_Click"/>
     <Button x:Name="NavUpdates" Content="↻    Actualizaciones" Style="{StaticResource NavButton}" Click="NavUpdates_Click"/>
    </StackPanel>
    <StackPanel Grid.Row="2">
     <Border Background="{DynamicResource Theme_111F30}" BorderBrush="{DynamicResource Theme_263A53}" BorderThickness="1" CornerRadius="11" Padding="13" Margin="0,0,0,15">
      <StackPanel><TextBlock Text="NEXORA PROTOCOL" Foreground="{DynamicResource Theme_6E829C}" FontSize="9" FontWeight="Bold"/><TextBlock Text="Tus archivos. En perfecta armonía." Foreground="{DynamicResource Theme_EAF2FD}" FontSize="13" FontWeight="SemiBold" Margin="0,7,0,3" TextWrapping="Wrap" MaxWidth="190"/><TextBlock Text="Privado, confiable y siempre bajo tu control." Foreground="{DynamicResource Theme_8498B2}" FontSize="10" TextWrapping="Wrap" MaxWidth="190"/></StackPanel>
     </Border>
