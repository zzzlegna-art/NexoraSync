        <Border Width="13" Height="13" CornerRadius="7" Background="#35C997" BorderBrush="{DynamicResource Theme_HeroStart}" BorderThickness="2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,24,42,0"/>
        <Border Background="{DynamicResource Theme_HeroPill}" BorderBrush="{DynamicResource Theme_HeroBorder}" BorderThickness="1" CornerRadius="10" Padding="10,7" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,2"><TextBlock Text="CONECTA  •  ORGANIZA  •  PROTEGE" Foreground="{DynamicResource Theme_HeroSubtext}" FontSize="8" FontWeight="Bold" CharacterSpacing="55"/></Border>
       </Grid>
      </Grid>
     </Border>
     <!-- KPI cards -->
     <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,20">
      <Border Background="{DynamicResource Theme_111C2B}" BorderBrush="{DynamicResource Theme_233249}" BorderThickness="1" CornerRadius="17" Padding="17" Margin="0,0,10,0">
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="48" Height="48" CornerRadius="16" Background="{DynamicResource Theme_KpiBlueBg}" VerticalAlignment="Top"><TextBlock Text="▤" Foreground="{DynamicResource Theme_KpiBlue}" FontSize="25" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="13,1,0,0"><TextBlock Text="EQUIPO ACTUAL" Foreground="{DynamicResource Theme_8295AF}" FontSize="8" FontWeight="Bold" CharacterSpacing="65"/><TextBlock Text="01" Foreground="{DynamicResource Theme_F1F6FD}" FontSize="31" FontWeight="Bold" Margin="0,4,0,0"/><TextBlock Text="Este dispositivo" Foreground="{DynamicResource Theme_7D91AA}" FontSize="10"/></StackPanel></Grid>
