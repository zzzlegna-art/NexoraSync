<Window x:Class="NexoraSync.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="NEXORA SYNC" Height="820" Width="1380" MinHeight="720" MinWidth="1120"
 WindowStartupLocation="CenterScreen" Background="#090E18" WindowStyle="SingleBorderWindow">
 <Window.Resources>
  <SolidColorBrush x:Key="Page" Color="#090E18"/>
  <SolidColorBrush x:Key="Sidebar" Color="#0D1421"/>
  <SolidColorBrush x:Key="Panel" Color="#111C2B"/>
  <SolidColorBrush x:Key="PanelAlt" Color="#152235"/>
  <SolidColorBrush x:Key="Line" Color="#233249"/>
  <SolidColorBrush x:Key="Muted" Color="#8797AE"/>
  <SolidColorBrush x:Key="TextMain" Color="#F2F6FC"/>
  <SolidColorBrush x:Key="Accent" Color="#4C9EFF"/>
  <Style x:Key="NavButton" TargetType="Button">
   <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#9AAAC0"/>
   <Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Left"/>
   <Setter Property="Padding" Value="15,12"/><Setter Property="Margin" Value="0,3"/>
   <Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#192A40"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Background" Value="#203B5D"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="PrimaryButton" TargetType="Button">
   <Setter Property="Background" Value="#398BEE"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Padding" Value="17,11"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#57A2FF"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Opacity" Value=".8"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
   <Setter Property="Background" Value="#1B2A3E"/><Setter Property="Foreground" Value="#DCE8F8"/>
  </Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#0B1421"/><Setter Property="Foreground" Value="#EAF1FB"/><Setter Property="BorderBrush" Value="#2A3B52"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,10"/><Setter Property="FontSize" Value="13"/><Setter Property="CaretBrush" Value="White"/></Style>
 </Window.Resources>
 <Grid x:Name="Root">
  <Grid.ColumnDefinitions><ColumnDefinition Width="248"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Grid.Column="0" Background="{StaticResource Sidebar}" BorderBrush="#1B293B" BorderThickness="0,0,1,0">
   <Grid Margin="19,22,17,18">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
     <StackPanel Orientation="Horizontal" Margin="4,2,0,34">
      <Border Width="37" Height="37" CornerRadius="11" Background="#183B62" BorderBrush="#2864A1" BorderThickness="1"><TextBlock Text="N" Foreground="#70B8FF" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
      <StackPanel Margin="11,0,0,0" VerticalAlignment="Center"><TextBlock Text="NEXORA" Foreground="#F4F8FF" FontSize="18" FontWeight="Bold"/><TextBlock Text="S Y N C" Foreground="#60AFFF" FontSize="9" FontWeight="Bold" Margin="1,1,0,0"/></StackPanel>
     </StackPanel>
     <TextBlock Text="ESPACIO DE TRABAJO" Foreground="#61738C" FontSize="9" FontWeight="Bold" Margin="9,0,0,10"/>
     <Button x:Name="NavOverview" Content="◫    Resumen" Style="{StaticResource NavButton}" Background="#172A40" Foreground="#FFFFFF" Click="NavOverview_Click"/>
     <Button Content="▣    Carpeta compartida" Style="{StaticResource NavButton}" Click="NavFolder_Click"/>
     <Button Content="◷    Actividad" Style="{StaticResource NavButton}" Click="NavActivity_Click"/>
     <Button Content="▤    Dispositivos" Style="{StaticResource NavButton}" Click="NavDevices_Click"/>
     <TextBlock Text="PREFERENCIAS" Foreground="#61738C" FontSize="9" FontWeight="Bold" Margin="9,27,0,10"/>
     <Button Content="⚙    Configuración" Style="{StaticResource NavButton}" Click="NavSettings_Click"/>
    </StackPanel>
    <StackPanel Grid.Row="2">
     <Border Background="#111F30" BorderBrush="#263A53" BorderThickness="1" CornerRadius="11" Padding="13" Margin="0,0,0,15">
      <StackPanel><TextBlock Text="NEXORA PROTOCOL" Foreground="#6E829C" FontSize="9" FontWeight="Bold"/><TextBlock Text="Your files. In sync." Foreground="#EAF2FD" FontSize="13" FontWeight="SemiBold" Margin="0,7,0,3"/><TextBlock Text="Private, reliable and always yours." Foreground="#8498B2" FontSize="10" TextWrapping="Wrap"/></StackPanel>
     </Border>
     <DockPanel><TextBlock Text="VERSION 0.1.4" Foreground="#536780" FontSize="9" FontWeight="Bold"/><TextBlock Text="● LOCAL PREVIEW" Foreground="#D5A85A" FontSize="9" FontWeight="Bold" HorizontalAlignment="Right"/></DockPanel>
    </StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Column="1" Margin="34,26,34,26">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <DockPanel Margin="0,0,0,27">
    <StackPanel DockPanel.Dock="Left"><TextBlock x:Name="PageTitle" Text="Resumen" Foreground="#F2F6FC" FontSize="26" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="Tu espacio de sincronización de un vistazo." Foreground="#899BB3" FontSize="12" Margin="0,6,0,0"/></StackPanel>
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
     <Border Background="#172536" BorderBrush="#2B405A" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,10,0"><StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="#E3B45F" Margin="0,0,8,0"/><TextBlock Text="Modo local" Foreground="#D7E2F1" FontSize="11" FontWeight="SemiBold"/></StackPanel></Border>
     <Button x:Name="ThemeButton" Content="☼   Tema claro" Style="{StaticResource SecondaryButton}" Click="ThemeButton_Click"/>
    </StackPanel>
   </DockPanel>
   <Grid Grid.Row="1">
    <Grid x:Name="OverviewPanel" Visibility="Visible">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Border Background="#10243A" BorderBrush="#234B72" BorderThickness="1" CornerRadius="15" Padding="25" Margin="0,0,0,19">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel VerticalAlignment="Center"><TextBlock Text="BIENVENIDO A TU NUBE PRIVADA" Foreground="#72B9FF" FontSize="9" FontWeight="Bold"/><TextBlock Text="Todo conectado." Foreground="White" FontSize="25" FontWeight="SemiBold" Margin="0,10,0,5"/><TextBlock Text="Un solo espacio para tus archivos en todos tus dispositivos autorizados." Foreground="#A8BED7" FontSize="12"/><Button Content="Configurar carpeta compartida   →" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,19,0,0" Click="NavFolder_Click"/></StackPanel>
       <Border Grid.Column="1" Width="126" Height="126" CornerRadius="63" Background="#17395A" BorderBrush="#2C659B" BorderThickness="1" Margin="25,0,8,0"><Grid><Ellipse Width="82" Height="82" Stroke="#3F91E5" StrokeThickness="1" Opacity=".65"/><Ellipse Width="55" Height="55" Stroke="#76B9FF" StrokeThickness="1.5"/><TextBlock Text="N" Foreground="#D9EEFF" FontSize="36" FontWeight="Light" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Border>
      </Grid>
     </Border>
     <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,19">
      <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="17" Margin="0,0,12,0"><StackPanel><TextBlock Text="DISPOSITIVOS CONECTADOS" Foreground="#8295AF" FontSize="9" FontWeight="Bold"/><TextBlock Text="01" Foreground="#F1F6FD" FontSize="27" FontWeight="SemiBold" Margin="0,8,0,2"/><TextBlock Text="Solo este equipo" Foreground="#7D91AA" FontSize="10"/></StackPanel></Border>
      <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="17" Margin="0,0,12,0"><StackPanel><TextBlock Text="CAMBIOS PENDIENTES" Foreground="#8295AF" FontSize="9" FontWeight="Bold"/><TextBlock Text="—" Foreground="#F1F6FD" FontSize="27" FontWeight="SemiBold" Margin="0,8,0,2"/><TextBlock Text="Motor de sincronización sin conectar" Foreground="#D9AD61" FontSize="10"/></StackPanel></Border>
      <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="17"><StackPanel><TextBlock Text="ESTADO DE SINCRONIZACIÓN" Foreground="#8295AF" FontSize="9" FontWeight="Bold"/><TextBlock Text="Local" Foreground="#F1F6FD" FontSize="27" FontWeight="SemiBold" Margin="0,8,0,2"/><TextBlock Text="Esperando configuración del servidor" Foreground="#D9AD61" FontSize="10"/></StackPanel></Border>
     </UniformGrid>
     <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,13,0">
       <StackPanel><DockPanel><TextBlock Text="Shared folder" Foreground="#F1F6FD" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="LOCAL LOCATION" Foreground="#70849F" FontSize="9" FontWeight="Bold" DockPanel.Dock="Right" VerticalAlignment="Center"/></DockPanel><TextBlock Text="Elige dónde estarán tus archivos sincronizados en este equipo." Foreground="#8498B1" FontSize="11" Margin="0,7,0,16" TextWrapping="Wrap"/><TextBox x:Name="FolderPath" Text="C:\NexoraSync\Shared" IsReadOnly="True"/><DockPanel Margin="0,12,0,0"><Button Content="Browse folder" Style="{StaticResource SecondaryButton}" Click="BrowseFolder_Click" DockPanel.Dock="Right" Margin="8,0,0,0"/><TextBlock x:Name="FolderStatus" Text="Carpeta sin configurar" Foreground="#8295AF" FontSize="10" VerticalAlignment="Center"/></DockPanel></StackPanel>
      </Border>
      <Border Grid.Column="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="20">
       <StackPanel><TextBlock Text="Actividad reciente" Foreground="#F1F6FD" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="Los eventos de tu espacio aparecerán aquí." Foreground="#8498B1" FontSize="11" Margin="0,7,0,17"/><StackPanel Orientation="Horizontal" Margin="0,5"><Ellipse Width="7" Height="7" Fill="#D9AD61" Margin="0,4,10,0"/><StackPanel><TextBlock Text="Esperando configuración" Foreground="#DCE7F5" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="Aún no hay actividad de sincronización" Foreground="#7488A2" FontSize="10" Margin="0,3,0,0"/></StackPanel></StackPanel><Border Height="1" Background="#26374D" Margin="0,15"/><TextBlock Text="When synchronization is enabled, file changes, device connections and conflict alerts will be listed here." Foreground="#778BA5" FontSize="10" TextWrapping="Wrap"/></StackPanel>
      </Border>
     </Grid>
    </Grid>
    <Grid x:Name="FolderPanel" Visibility="Collapsed">
     <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="14" Padding="26" VerticalAlignment="Top">
      <StackPanel><TextBlock Text="Tu espacio compartido" Foreground="#F1F6FD" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Selecciona la carpeta local que compartirás con tus dispositivos NEXORA autorizados." Foreground="#8498B1" FontSize="12" Margin="0,8,0,22" TextWrapping="Wrap"/><TextBlock Text="CARPETA LOCAL" Foreground="#8498B1" FontSize="9" FontWeight="Bold" Margin="0,0,0,8"/><DockPanel><Button Content="Choose folder" Style="{StaticResource PrimaryButton}" DockPanel.Dock="Right" Click="BrowseFolder_Click" Margin="12,0,0,0"/><TextBox x:Name="FolderPathSettings" Text="C:\NexoraSync\Shared" IsReadOnly="True"/></DockPanel><TextBlock x:Name="FolderStatusSettings" Text="La selección de carpeta se guarda en este equipo." Foreground="#7F93AC" FontSize="11" Margin="0,12,0,0"/><Button Content="Guardar preferencias de carpeta" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,22,0,0" Click="Save_Click"/></StackPanel>
     </Border>
    </Grid>
    <Grid x:Name="ActivityPanel" Visibility="Collapsed"><Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="14" Padding="26" VerticalAlignment="Top"><StackPanel><TextBlock Text="Centro de actividad" Foreground="#F1F6FD" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="A complete timeline of file updates, transfers, devices and conflicts will live here." Foreground="#8498B1" FontSize="12" Margin="0,8,0,18" TextWrapping="Wrap"/><Border Background="#18283C" CornerRadius="9" Padding="16"><TextBlock Text="No activity yet · Synchronization service is not connected." Foreground="#D8B16C" FontSize="12"/></Border></StackPanel></Border></Grid>
    <Grid x:Name="DevicesPanel" Visibility="Collapsed"><Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="14" Padding="26" VerticalAlignment="Top"><StackPanel><TextBlock Text="Dispositivos autorizados" Foreground="#F1F6FD" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Administra los equipos que pueden acceder a tu espacio compartido." Foreground="#8498B1" FontSize="12" Margin="0,8,0,18"/><Border Background="#18283C" CornerRadius="9" Padding="16"><StackPanel><TextBlock Text="Este equipo" Foreground="#EAF2FC" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="Registered locally · Remote pairing is not available yet." Foreground="#D8B16C" FontSize="11" Margin="0,5,0,0"/></StackPanel></Border></StackPanel></Border></Grid>
    <Grid x:Name="SettingsPanel" Visibility="Collapsed"><Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="14" Padding="26" VerticalAlignment="Top"><StackPanel><TextBlock Text="Preferencias" Foreground="#F1F6FD" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Personaliza tu experiencia con NEXORA SYNC." Foreground="#8498B1" FontSize="12" Margin="0,8,0,20"/>
      <TextBlock Text="IDIOMA" Foreground="#8498B1" FontSize="9" FontWeight="Bold" Margin="0,0,0,8"/><ComboBox x:Name="LanguageBox" SelectedIndex="0" SelectionChanged="LanguageBox_SelectionChanged" Padding="8" Margin="0,0,0,18"><ComboBoxItem Content="Español"/><ComboBoxItem Content="English"/></ComboBox><TextBlock Text="DIRECCIÓN DEL SERVIDOR" Foreground="#8498B1" FontSize="9" FontWeight="Bold" Margin="0,0,0,8"/><TextBox x:Name="ServerUrl" Text="https://" Margin="0,0,0,8"/><TextBlock Text="The remote server and synchronization engine are not configured in this prototype." Foreground="#D8B16C" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,17"/><Button Content="Guardar preferencias locales" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="Save_Click"/><TextBlock x:Name="SaveStatus" Foreground="#79D8B0" FontSize="11" Margin="0,12,0,0"/></StackPanel></Border></Grid>
<Grid x:Name="GuidePanel" Visibility="Collapsed"><Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="14" Padding="26" VerticalAlignment="Top"><StackPanel><TextBlock Text="Primeros pasos con NEXORA" Foreground="#F1F6FD" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Configura tu espacio de trabajo en tres pasos." Foreground="#8498B1" FontSize="12" Margin="0,8,0,20"/><TextBlock Text="01 · Elige tu carpeta compartida" Foreground="#EAF2FC" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="Selecciona la ubicación local donde guardarás tus archivos." Foreground="#91A4BC" FontSize="11" Margin="0,5,0,16"/><TextBlock Text="02 · Configura el servidor" Foreground="#EAF2FC" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="Cuando el servicio esté disponible, introduce la dirección del servidor en Configuración." Foreground="#91A4BC" FontSize="11" Margin="0,5,0,16"/><TextBlock Text="03 · Autoriza tus equipos" Foreground="#EAF2FC" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="Vincula únicamente los computadores que deban acceder a tus archivos." Foreground="#91A4BC" FontSize="11" Margin="0,5,0,16"/><Border Background="#352B1D" CornerRadius="9" Padding="14"><TextBlock Text="Nota: esta versión guarda preferencias localmente. La sincronización entre equipos aún está en desarrollo." Foreground="#E7C58D" FontSize="11" TextWrapping="Wrap"/></Border></StackPanel></Border></Grid><Grid x:Name="UpdatesPanel" Visibility="Collapsed"><Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="14" Padding="26" VerticalAlignment="Top"><StackPanel><TextBlock Text="Actualizaciones" Foreground="#F1F6FD" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Comprueba si hay una versión más reciente." Foreground="#8498B1" FontSize="12" Margin="0,8,0,20"/><TextBlock Text="VERSIÓN INSTALADA" Foreground="#8498B1" FontSize="9" FontWeight="Bold"/><TextBlock Text="0.1.5" Foreground="#F1F6FD" FontSize="26" FontWeight="SemiBold" Margin="0,5,0,8"/><TextBlock x:Name="UpdateStatus" Text="Listo para buscar actualizaciones." Foreground="#9CB0C9" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,14"/><Button x:Name="CheckUpdatesButton" Content="Buscar actualizaciones" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="CheckUpdates_Click"/><TextBlock Text="La descarga e instalación seguirán siendo manuales en esta versión." Foreground="#8498B1" FontSize="11" Margin="0,16,0,0"/></StackPanel></Border></Grid>   </Grid>
  </Grid>
 </Grid>
</Window>