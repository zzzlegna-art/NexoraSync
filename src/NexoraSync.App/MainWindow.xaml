       <StackPanel>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="TU ESPACIO" Foreground="{DynamicResource Theme_70B8FF}" FontSize="9" FontWeight="Bold" CharacterSpacing="100"/><TextBlock Text="Carpeta compartida" Foreground="{DynamicResource Theme_F1F6FD}" FontSize="19" FontWeight="Bold" Margin="0,5,0,0"/></StackPanel><Border Grid.Column="1" Background="{DynamicResource Theme_KpiGreenBg}" CornerRadius="10" Padding="10,6" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="#35C997" Margin="0,0,7,0"/><TextBlock Text="LOCAL" Foreground="{DynamicResource Theme_KpiGreen}" FontSize="9" FontWeight="Bold"/></StackPanel></Border></Grid>
